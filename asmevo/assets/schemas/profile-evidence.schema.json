{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asmevo:schema:profile-evidence:v2",
  "title": "AsmEvo v2 profile evidence",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status",
    "artifact_sha256",
    "target_arch",
    "contract_sha256",
    "environment_sha256",
    "kernel_symbol",
    "dispatch_count",
    "sampled_time_ms",
    "hotspots",
    "resources",
    "bottleneck_class",
    "profiler",
    "raw_files"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "kind": {"const": "asmevo.profile-evidence.v2"},
    "status": {"const": "complete"},
    "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "target_arch": {"type": "string", "pattern": "^gfx[0-9a-z]+$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "environment_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kernel_symbol": {"type": "string", "minLength": 1},
    "dispatch_count": {"type": "integer", "minimum": 1},
    "sampled_time_ms": {"type": "number", "exclusiveMinimum": 0},
    "hotspots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_pc", "end_pc", "weight"],
        "properties": {
          "start_pc": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
          "end_pc": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
          "weight": {"type": "number", "exclusiveMinimum": 0}
        },
        "additionalProperties": true
      }
    },
    "counters": {"type": "object"},
    "unavailable_counters": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    },
    "resources": {"type": "object"},
    "bottleneck_class": {"type": "string", "minLength": 1},
    "profiler": {"type": "object"},
    "raw_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["relative_path", "sha256", "size_bytes"],
        "properties": {
          "relative_path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
