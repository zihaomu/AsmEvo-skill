{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:asmevo:schema:asm-candidate:v2",
  "title": "AsmEvo v2 AMDGCN assembly proposal",
  "type": "object",
  "required": [
    "schema_version",
    "optimization_surface",
    "parent_sha256",
    "profile_evidence_sha256",
    "kernel_symbol",
    "bottleneck_class",
    "edited_windows",
    "hypothesis",
    "expected_observation",
    "hazards",
    "source_path"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "optimization_surface": {"const": "amdgcn_assembly"},
    "parent_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "kernel_symbol": {"type": "string", "minLength": 1},
    "bottleneck_class": {"type": "string", "minLength": 1},
    "edited_windows": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["start_pc", "end_pc"],
        "properties": {
          "start_pc": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"},
          "end_pc": {"type": "string", "pattern": "^0x[0-9a-fA-F]+$"}
        },
        "additionalProperties": false
      }
    },
    "hypothesis": {"type": "string", "minLength": 1},
    "expected_observation": {"type": "string", "minLength": 1},
    "hazards": {"type": "array", "items": {"type": "string"}},
    "source_path": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false
}
